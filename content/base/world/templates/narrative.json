{
  "id": "templates/narrative",
  "entries": {
    "DayStart": {
      "kind": "info",
      "text": "第 {day} 天。你在引擎的低鳴中醒來。"
    },
    "DaySummary": {
      "kind": "info",
      "text": "這一天的帳與傷都記下了。"
    },
    "RiftPhase": {
      "kind": "warn",
      "text": "裂縫 {rift} 的狀態轉為 {phase}。"
    },
    "NodeBlighted": {
      "kind": "warn",
      "text": "{node.name} 被蝕線吞沒。"
    },
    "NodeReclaimed": {
      "kind": "info",
      "text": "{node.name} 的蝕線退了。"
    },
    "Arrived": {
      "kind": "info",
      "text": "候鳥號抵達 {node.name}。"
    },
    "Encounter": {
      "kind": "warn",
      "text": "{node.name} 前方有動靜，警報打斷了談話。"
    },
    "EventOffered": {
      "kind": "info",
      "text": "一件事等著你決定。"
    },
    "Chosen": {
      "kind": "info",
      "text": "你做出了選擇。"
    },
    "JobDone": {
      "kind": "info",
      "text": "工作 {job} 完成；技師把工具放回架上。"
    },
    "Tamed": {
      "kind": "info",
      "text": "{mech} 終於讓鐵鍊鬆下來。"
    },
    "Molted": {
      "kind": "blood",
      "text": "{mech} 褪下舊殼，新皮還在滲血。"
    },
    "Brooded": {
      "kind": "blood",
      "text": "獸欄裡多了一道呼吸。"
    },
    "Mutated": {
      "kind": "blood",
      "text": "{mech} 的輪廓變了。"
    },
    "Accompanied": {
      "kind": "soul",
      "text": "{by.name} 陪 {soul.name} 坐了一會兒。"
    },
    "NodeMastered": {
      "kind": "soul",
      "text": "{soul.name} 記住了新的迴路。"
    },
    "WagePaid": {
      "kind": "money",
      "text": "你付給 {person.name} {amount} 幣薪水。"
    },
    "WageOwed": {
      "kind": "warn",
      "text": "{person.name} 的薪水還欠 {amount} 幣。"
    },
    "InterestPosted": {
      "kind": "money",
      "text": "債息 {amount} 幣入帳。"
    },
    "Posted": {
      "kind": "money",
      "text": "{account} 變動 {delta}。"
    },
    "ContractOffered": {
      "kind": "info",
      "text": "終端掛出契約 {contract}。"
    },
    "ContractAccepted": {
      "kind": "money",
      "text": "你接下契約 {contract}。"
    },
    "ContractDone": {
      "kind": "money",
      "text": "契約 {contract} 已結清。"
    },
    "ContractFailed": {
      "kind": "warn",
      "text": "契約 {contract} 失敗，終端沒有多說一句。"
    },
    "ContractCancelled": {
      "kind": "warn",
      "text": "你撤銷了契約 {contract}。"
    },
    "ContractExpired": {
      "kind": "warn",
      "text": "契約 {contract} 已過期。"
    },
    "Hired": {
      "kind": "info",
      "text": "{person.name} 把行李搬上船。"
    },
    "Left": {
      "kind": "warn",
      "text": "{person.name} 帶走了行李。"
    },
    "Died": {
      "kind": "blood",
      "text": "{person.name} 的名字移到了名冊最後一頁。"
    },
    "BattleResolved": {
      "kind": "blood",
      "text": "戰鬥結束。你開始清點回來的人與機甲。"
    },
    "Woken": {
      "kind": "soul",
      "text": "{shell} 回答了呼喚。"
    },
    "Named": {
      "kind": "soul",
      "text": "{by.name} 叫它「{name}」。"
    },
    "CampaignEnd": {
      "kind": "info",
      "text": "這段航程到此為止。"
    },
    "LostMech": {
      "kind": "blood",
      "text": "{mech} 沒有回到固定架上。"
    },
    "CampaignStarted": {
      "kind": "info",
      "text": "候鳥號的新航程開始。你接過帳本，也接過那筆債。"
    },
    "OpsEffectApplied": {
      "kind": "info",
      "text": "船上的紀錄更新了。"
    }
  }
}
