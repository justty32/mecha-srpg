          }
        ]
      },
      "lines": [
        "伊爾瑟翻著百燈破圍的舊訊，用手比出盾邊的空隙。",
        "「伊沃給第三刃的傷機讓了路，修盾的錢照討。」",
        "「小氣。可他那面盾，確實挪得漂亮。」",
        "她抬肘側身。「留這麼寬。活路也算戰績，別堵了。」"
      ],
      "choices": [
        {
          "effects": [
            {
              "flag": "seen-bf-ilse-brandt-paid-window"
            }
          ],
          "text": "和她一起嫌伊沃小氣。"
        },
        {
          "effects": [
            {
              "flag": "seen-bf-ilse-brandt-paid-window"
            },
            {
              "mood": {
                "all": 1
              }
            }
          ],
          "text": "請她示範挪盾，留出傷機的路。"
        }
      ]
    }
  ]
