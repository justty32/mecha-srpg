      {"type":"object","required":["sum"],"properties":{"sum":{"type":"array","items":{"$ref":"#/$defs/NumExpr"}}},"additionalProperties":false},
      {"type":"object","required":["product"],"properties":{"product":{"type":"array","items":{"$ref":"#/$defs/NumExpr"}}},"additionalProperties":false},
      {"type":"object","required":["pick"],"properties":{"pick":{"type":"object","required":["if","then","else"],"properties":{"if":{"$ref":"#/$defs/Cond"},"then":{"$ref":"#/$defs/NumExpr"},"else":{"$ref":"#/$defs/NumExpr"}},"additionalProperties":false}},"additionalProperties":false}
    ]},
    "Cond": {"type":"object","properties":{
