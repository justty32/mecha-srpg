{
  "id": "dialogue/mitali-das-wake-call",
  "person": "person/mitali-das",
  "name": "米塔莉・達斯",
  "topics": [
    {
      "topic": "叫醒船屋的人",
      "when": {
        "cmp": {
          "a": {
            "ref": "flags.dlg-mitali-das-wake-call"
          },
          "op": "==",
          "b": 0
        }
      },
      "lines": [
        "你蹲下看米塔莉用繩頭擺出的船屋。她先把靠岸那條抽走。「牠來以前，水會先不肯靠岸。」",
        "「叫大家起床，他們會罵。沒醒的，就不會了。」她看著你。「這裡可以敲鍋嗎？」"
      ],
      "choices": [
        {
          "text": "指給她看值夜人的位置。",
          "effects": [
            {
              "flag": "dlg-mitali-das-wake-call"
            }
          ]
        },
        {
          "text": "用團款替夜哨添一盞防潮燈。",
          "effects": [
            {
              "ledger": {
                "account": "cash",
                "delta": -80,
                "reason": "event-mitali-das-wake-call"
              }
            },
            {
              "flag": "dlg-mitali-das-wake-call"
            },
            {
              "mood": {
                "person/mitali-das": 1
              }
            }
          ],
          "requires": {
            "cmp": {
              "a": {
                "ref": "ledger.balances.cash"
              },
              "op": ">=",
              "b": 80
            }
          }
        }
      ]
    },
    {
      "topic": "叫醒船屋的人・後話",
      "when": {
        "cmp": {
          "a": {
            "ref": "flags.dlg-mitali-das-wake-call"
          },
          "op": ">=",
          "b": 1
        }
      },
      "lines": [
        "你路過酒艙，米塔莉把鍋放在伸手就夠得到的地方。「先叫醒，再挨罵。我記得。」"
      ]
    }
  ]
}
