      "lines": [
        "伊爾瑟翻過蘇伊士運河的換班記錄，站到門口。",
        "「賽芙娜吃過等章的虧。現在得等機甲到船旁。」",
        "「章不會長腿。接班的機甲到了再叫我。」",
        "你問她又要最後撤？她側身讓路。「這回先換你站。」"
      ],
      "choices": [
        {
          "effects": [
            {
              "flag": "seen-bf-ilse-brandt-watch"
            }
          ],
          "text": "提醒她別又站到最後。"
        },
        {
          "effects": [
            {
              "flag": "seen-bf-ilse-brandt-watch"
            },
            {
              "mood": {
                "all": 1
              }
            }
          ],
          "text": "陪她把換班路線走完。"
        }
      ]
    }
