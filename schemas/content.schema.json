    "SlotDecl": {"type":"object","required":["id","type","size"],"properties":{"id":{"type":"string"},"type":{"type":"string"},"size":{"type":"number"}},"additionalProperties":false},
    "SeatDecl": {"type":"object","required":["id","accepts"],"properties":{"id":{"type":"string"},"accepts":{"type":"array","items":{"$ref":"#/$defs/SeatRole"}}},"additionalProperties":false},
    "PartDef": {"type":"object","required":["id","name","exposure","layers","slots","functions","onLayerBroken","onBroken","conduct"],"properties":{
