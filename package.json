{
  "name": "mecha-srpg",
  "version": "0.1.0",
  "private": true,
  "description": "2108 地月機甲戰爭網頁文字 SRPG：純 TypeScript 戰術引擎（node 24 原生執行 .ts）",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sim": "node src/sim/cli.ts",
    "content:probe": "node src/sim/probe.ts",
    "content:index": "python3 -I wf/tools/content_index.py",
    "sim:campaign": "node src/ops/sim/cli.ts",
    "fuzz": "node test/fuzz/cli.ts",
    "mcp": "node src/mcp/server.ts",
    "test": "node --test --test-reporter=tap 'src/**/*.test.ts' 'test/**/*.test.ts'",
    "check": "node src/content/loader.ts content/base",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:dom": "node --test --test-reporter=tap 'src/ui-adapter/**/*.test.ts'",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
