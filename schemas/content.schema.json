    "EffectRef": {"oneOf":[{"$ref":"#/$defs/Id"},{"type":"object","required":["effect"],"properties":{"effect":{"$ref":"#/$defs/Id"},"params":{"type":"object","additionalProperties":{"$ref":"#/$defs/NumExpr"}},"chance":{"$ref":"#/$defs/NumExpr"}},"additionalProperties":false}]},
