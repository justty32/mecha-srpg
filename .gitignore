# node / 網頁版
node_modules/
dist/

# inbox 輪詢已讀狀態不進版控（見 wf/workflows/inbox/PROTOCOL.md）
wf/inbox/.state/

# 線的丟棄物與 codex log 不進版控
wf/workflows/dispatch/handoffs/*/trash/
wf/workflows/dispatch/handoffs/**/trash/
test-results/
playwright-report/

# 線的原始證據只留本機、不入庫（2026-11-05 slim-1105；git 歷史即封存）
wf/workflows/dispatch/handoffs/*/raw/
wf/workflows/dispatch/handoffs/**/*.tap
wf/workflows/dispatch/handoffs/**/*.jsonl
wf/workflows/dispatch/handoffs/**/*.gz
wf/workflows/dispatch/handoffs/**/*.log
# 已辦信件只留本機（已辦的證據是 commit）
wf/inbox/done/*
!wf/inbox/done/.gitkeep
# 美術試作的證據圖由 headless.mjs 重產
art/*/evidence/
art/*/viewer/evidence/

# Claude Code 隔離 worktree
.claude/worktrees/
