    "Actions": {"type":"array","items":{"$ref":"#/$defs/HookAction"}},
    "PoolBand": {"type":"object","required":["from","to","effects"],"properties":{"from":{"$ref":"#/$defs/NumExpr"},"to":{"anyOf":[{"$ref":"#/$defs/NumExpr"},{"type":"null"}]},"effects":{"$ref":"#/$defs/Effects"},"label":{"type":"string"}},"additionalProperties":false},
    "PoolDecl": {"type":"object","required":["id","name","min","max","capKind","inverted","initial","regen","bands"],"properties":{
