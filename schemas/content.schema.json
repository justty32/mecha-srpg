    "ConductRule": {"type":"object","required":["when","to","effects"],"properties":{"when":{"enum":["layerHit","layerBroken","partBroken"]},"layer":{"type":"string"},"to":{"enum":["pilot","soul","allSeats"]},"effects":{"$ref":"#/$defs/Effects"},"chance":{"$ref":"#/$defs/NumExpr"}},"additionalProperties":false},
