                "ref": "ledger.balances.cash"
              },
              "op": ">=",
              "b": 160
            }
          }
        }
      ]
    },
    {
      "topic": "贖回的工具箱・後話",
      "when": {
        "cmp": {
          "a": {
            "ref": "flags.dlg-irina-sokolova-toolbox"
          },
          "op": ">=",
          "b": 1
        }
      },
      "lines": [
        "你看見那塊布折在架邊。伊琳娜拿起扳手。「月面教我怎麼落地。這艘船最好教我怎麼留下。」"
      ]
    }
  ]
