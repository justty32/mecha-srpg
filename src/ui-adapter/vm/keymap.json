{
  "version": 1,
  "bindings": [
    { "action": "endTurn", "keys": ["e"], "label": "結束回合" },
    { "action": "wait", "keys": ["w"], "label": "待機（移到本輪隊尾）" },
    { "action": "beginMove", "keys": ["m"], "label": "移動" },
    { "action": "abilitySlot:1", "keys": ["1"], "label": "能力 1" },
    { "action": "abilitySlot:2", "keys": ["2"], "label": "能力 2" },
    { "action": "abilitySlot:3", "keys": ["3"], "label": "能力 3" },
    { "action": "abilitySlot:4", "keys": ["4"], "label": "能力 4" },
    { "action": "abilitySlot:5", "keys": ["5"], "label": "能力 5" },
    { "action": "abilitySlot:6", "keys": ["6"], "label": "能力 6" },
    { "action": "abilitySlot:7", "keys": ["7"], "label": "能力 7" },
    { "action": "abilitySlot:8", "keys": ["8"], "label": "能力 8" },
    { "action": "abilitySlot:9", "keys": ["9"], "label": "能力 9" },
    { "action": "cancel", "keys": ["Escape"], "label": "取消" },
    { "action": "confirm", "keys": ["Enter", " "], "label": "確認游標格" },
    { "action": "cursor:0,-1", "keys": ["ArrowUp"], "label": "游標上" },
    { "action": "cursor:0,1", "keys": ["ArrowDown"], "label": "游標下" },
    { "action": "cursor:-1,0", "keys": ["ArrowLeft"], "label": "游標左" },
    { "action": "cursor:1,0", "keys": ["ArrowRight"], "label": "游標右" },
    { "action": "scroll:0,-10", "keys": ["Shift+ArrowUp"], "label": "捲動上" },
    { "action": "scroll:0,10", "keys": ["Shift+ArrowDown"], "label": "捲動下" },
    { "action": "scroll:-10,0", "keys": ["Shift+ArrowLeft"], "label": "捲動左" },
    { "action": "scroll:10,0", "keys": ["Shift+ArrowRight"], "label": "捲動右" },
    { "action": "nextUnit", "keys": ["Tab"], "label": "下一台我方單位" },
    { "action": "centerActive", "keys": ["c"], "label": "鏡頭回到行動中單位" },
    { "action": "eject", "keys": ["Shift+x"], "label": "棄機" },
    { "action": "retreat", "keys": ["Shift+r"], "label": "撤離" },
    { "action": "toggleHelp", "keys": ["Shift+?", "?", "h"], "label": "快捷鍵說明" }
  ]
}
